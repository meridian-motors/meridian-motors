# =============================================================================
# MERIDIAN MOTORS — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — no secrets there.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used only after explicit authorisation checks,
# and for webhooks, cron jobs and imports.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (AI features) ------------------------------------------------
# Without a key, AI features show an "unavailable" state and rule-based
# fallbacks are used (search parsing, deterministic valuation explanations).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Stripe (payments) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Meridian Motors <no-reply@yourdomain.co.uk>"

# --- DVLA Vehicle Enquiry Service --------------------------------------------
# Apply at https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_VES_API_KEY=
# Optional override (e.g. the UAT endpoint during testing)
DVLA_VES_API_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# --- Sentry (error monitoring) ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Platform ---------------------------------------------------------------
# Shared secret for Vercel Cron → /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=
# Random string used to hash visitor IPs for rate limiting & view de-duplication
SESSION_HASH_SALT=
# Set to "false" to disable postcode-district geocoding (postcodes.io)
GEOCODING_ENABLED=true

# --- Super-admin provisioning (one-off; see docs/SETUP.md) --------------------
# Used only by `npm run admin:provision`; remove afterwards.
SUPER_ADMIN_EMAIL=
